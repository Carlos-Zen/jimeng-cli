{
  "manifest_version": 3,
  "name": "jimeng-cli Browser Bridge",
  "version": "0.1.1",
  "description": "让 jimeng-cli 命令行驱动你已登录的即梦网页（jimeng.jianying.com）：上传素材、填写提示词、提交生成、查询结果。仅连接本机 127.0.0.1。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "jimeng-cli", "default_popup": "popup.html" }
}
